# ── 音声・文字起こしファイル ──────────────────────────
*.wav
*.mp3
*.mp4
transcript_*.txt
corrected_*.txt
summary_*.md
test_audio_*.wav

# ── 設定ファイル（API キーを含む） ───────────────────
config.ini

# ── ランタイム状態ファイル ────────────────────────────
.pipeline_session
.pipeline_stop
.pipeline_session_done
.pipeline_ready
.pipeline.lock
.last_transcript
.last_corrected
.last_translated
.last_final_corrected
.last_language
.stop_signal
.recording_start
.ptt_stop
.tmp_*.wav
.tmp_*.raw

# ── ログファイル ──────────────────────────────────────
*.log

# ── ビルド成果物 ──────────────────────────────────────
dist/
run.bat

# ── ローカルモデル（大容量のためgit管理外）───────────
models/*/model.bin
models/*/model.bin.1

# ── Python キャッシュ ─────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── ビルドキャッシュ（マシン固有・自動生成）──────────
# build_installer.bat が ISCC.exe の絶対パスをキャッシュする。マシンごとに
# 異なり（ユーザー名を含む）、無ければ自動再生成されるので追跡しない。
.iscc_path

